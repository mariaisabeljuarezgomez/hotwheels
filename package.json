    "helmet": "8.3.0",
    "markdown-it": "15.0.3",
    "multer": "2.5.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
